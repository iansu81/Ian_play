struct Participant {
std::string user_id;
double weight;
};

struct Candidate {
std::string user_id;
double score;

bool operator>(const Candidate& other) const {
    return score > other.score;
}

};

class LotterySystem {
public:
static std::vectorstd::string drawWinners(const std::vector& participants, int k) {
std::vectorstd::string winners;
if (participants.empty() || k <= 0) return winners;
if (k >= participants.size()) {
for (const auto& p : participants) winners.push_back(p.user_id);
return winners;
}

    std::priority_queue<Candidate, std::vector<Candidate>, std::greater<Candidate>> min_heap;
    std::random_device rd;
    std::mt19937 gen(rd());
    std::uniform_real_distribution<double> dis(0.0, 1.0);

    for (const auto& p : participants) {
        if (p.weight <= 0) continue;
        double r = dis(gen);
        double score = std::pow(r, 1.0 / p.weight);

        if (min_heap.size() < k) {
            min_heap.push({p.user_id, score});
        } else if (score > min_heap.top().score) {
            min_heap.pop();
            min_heap.push({p.user_id, score});
        }
    }

    while (!min_heap.empty()) {
        winners.push_back(min_heap.top().user_id);
        min_heap.pop();
    }
    std::reverse(winners.begin(), winners.end());
    return winners;
}

};